# Required
OPENAI_API_KEY=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=

# Optional: evaluator models for src/m4_eval.py (separate from generation/judge).
# Empty values are invalid when explicitly set; leave the defaults below or omit.
RAGAS_LLM_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_MAX_WORKERS=4
